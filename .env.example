# ==============================================================================
# WebCraft AI Studio — Environment Configuration
# ==============================================================================

# 1. Google Gemini AI API Key (Server-side ONLY, never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Database (PostgreSQL is primary production database)
# Example: postgresql://username:password@hostname:5432/webcraft?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webcraft

# 3. Owner / Administrator Secret Credentials (Bootstrapped exclusively from env)
ADMIN_EMAIL=owner@webcraft.local
ADMIN_PASSWORD=change_this_to_a_strong_secret_password_in_production

# 4. Session Security Secret (Used for signing authentication cookies/tokens)
SESSION_SECRET=super_secret_session_key_minimum_32_characters_random

# 5. Server Options
PORT=3000
NODE_ENV=production
